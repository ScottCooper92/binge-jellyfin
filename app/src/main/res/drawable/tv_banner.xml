<?xml version="1.0" encoding="utf-8"?>
<!--
    The Android TV home-screen banner, 320x180 at xhdpi as the platform asks for, drawn as a vector so the
    companion's mark is the one source for both the icon and the banner. The group is the launcher
    foreground's own geometry (a 108 viewport) scaled 1.625 and centred on 160,90.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="320dp"
    android:height="180dp"
    android:viewportWidth="320"
    android:viewportHeight="180">
    <path
        android:fillColor="#1F1228"
        android:pathData="M0,0h320v180h-320z" />
    <group
        android:scaleX="1.625"
        android:scaleY="1.625"
        android:translateX="72.25"
        android:translateY="2.25">
        <path
            android:pathData="M54,22 A32,32 0 1,0 54,86 A32,32 0 1,0 54,22 Z"
            android:strokeColor="#AA5CC3"
            android:strokeAlpha="0.20"
            android:strokeWidth="6" />
        <path
            android:pathData="M54,22 A32,32 0 1,1 54,86 A32,32 0 1,1 54,22 Z"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:trimPathStart="0"
            android:trimPathEnd="0.84">
            <aapt:attr name="android:strokeColor">
                <gradient
                    android:type="linear"
                    android:startX="54"
                    android:startY="22"
                    android:endX="54"
                    android:endY="86">
                    <item android:offset="0.0" android:color="#FFCC9BDD" />
                    <item android:offset="1.0" android:color="#FF7E3A95" />
                </gradient>
            </aapt:attr>
        </path>
        <path
            android:fillColor="#AA5CC3"
            android:pathData="M38,52 C38,40 45,34 54,34 C63,34 70,40 70,52 Q66,49 62,52 Q58,49 54,52 Q50,49 46,52 Q42,49 38,52 Z" />
        <path
            android:pathData="M46,52 C43,57 49,61 46,66 C45,68 46,70 47,72"
            android:strokeColor="#AA5CC3"
            android:strokeWidth="3.8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M54,52 C57,58 51,63 54,68 C55,70 54,71 54,73"
            android:strokeColor="#AA5CC3"
            android:strokeWidth="3.8"
            android:strokeLineCap="round" />
        <path
            android:pathData="M62,52 C59,57 65,61 62,66 C61,68 62,70 61,72"
            android:strokeColor="#AA5CC3"
            android:strokeWidth="3.8"
            android:strokeLineCap="round" />
    </group>
</vector>
