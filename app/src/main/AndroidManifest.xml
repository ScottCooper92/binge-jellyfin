<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Finding the server on the network: a UDP broadcast to Jellyfin's discovery port. Android 17 asks
        the user for it at run time; earlier versions grant it with INTERNET. Refused, the address is
        typed instead.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- To find the device's Wi-Fi and Ethernet networks, and send the broadcast on them. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- An administrator's opt-in notifications of failed sign-ins, lockouts and server warnings. Asked for when the switch is turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!--
        Cleartext is allowed because most home Jellyfin servers are plain http on the LAN. The app's
        screens say so wherever an http server is shown.
    -->
    <queries>
        <!-- A browser that can open a web address, so the rows that open one are offered only where one exists. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:name=".JellyfinApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_label"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Hands one log file to the share sheet; see ui/console/LogShare.kt. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.logs"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/log_share_paths" />
        </provider>

        <!-- The launch theme is the splash one; installSplashScreen() swaps in Theme.Jellyfin as it hands over. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Jellyfin.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Another app opens one title here. A public contract (see OpenItemActivity): the action and extras never change once
            released. DEFAULT only, so a web page cannot reach it. It has no task affinity: it must not run inside the app's own
            task, or an intent for a running app lands in the entry above it and never reaches the app.
        -->
        <activity
            android:name=".OpenItemActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.cooper.homelab.ephyra.action.OPEN_ITEM" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Binge's "manage" row: started for a result, so callingPackage is set and checked. -->
        <activity
            android:name=".SettingsHandOffActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="com.binge.companion.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            The integration surface. exported="true": the caller policy in JellyfinCompanionService is
            what guards it. Binge reads the meta-data without binding.
        -->
        <service
            android:name=".service.JellyfinCompanionService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.binge.companion.LIBRARY" />
            </intent-filter>

            <meta-data
                android:name="com.binge.companion.name"
                android:value="@string/companion_label" />
            <meta-data
                android:name="com.binge.companion.icon"
                android:resource="@drawable/ic_companion" />
            <meta-data
                android:name="com.binge.companion.color"
                android:resource="@color/companion_brand" />
            <meta-data
                android:name="com.binge.companion.color.dark"
                android:resource="@color/companion_brand_dark" />
            <meta-data
                android:name="com.binge.companion.majors"
                android:value="1" />
            <meta-data
                android:name="com.binge.companion.majors.library"
                android:value="1" />
        </service>

        <!-- WorkManager's own initialiser is removed so it starts through JellyfinApp's configuration, whose worker factory builds the poll's worker. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <!-- Crash reports are opt-in. Crashlytics collects from the first launch unless told not to, so this switches it off
             until the user's stored answer turns it on (`CrashReportingSwitch` in homelab-core, wired in `AppGraph.crashReporting`). -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>

</manifest>
