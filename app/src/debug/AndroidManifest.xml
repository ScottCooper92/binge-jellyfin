<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
            Debug builds only. Turns the shared library's per-server stores on or off for the next launch:
            adb shell am broadcast -a APPLICATION_ID.SERVER_REGISTRY, naming the package with -p, and the boolean extra enabled set to true
            The DUMP permission is held by the shell and by no ordinary app, so only adb can send it.
        -->
        <receiver
            android:name="com.cooper.binge.companion.jellyfin.debug.ServerRegistrySwitchReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="${applicationId}.SERVER_REGISTRY" />
                <action android:name="${applicationId}.ADDRESS_POLICY" />
                <action android:name="${applicationId}.SEARCH_TOGGLES" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
