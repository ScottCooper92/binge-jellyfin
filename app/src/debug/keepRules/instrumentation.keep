    com.binge.companion.contracts.v1.HostInfo$Builder setPackageName(java.lang.String);
    com.binge.companion.contracts.v1.HostInfo$Builder setVersionCode(long);
    com.binge.companion.contracts.v1.HostInfo$Builder setVersionName(java.lang.String);
