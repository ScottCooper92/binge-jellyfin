# Debug only: exactly what the instrumentation test calls in the minified app under test.
#
# When the app under test is minified, the test APK leaves out every library the app already
# carries, and resolves those classes and members from the app at run time. R8 strips what the app
# itself never uses, so the test would fail before it starts (NoClassDefFoundError, "0 tests") or
# mid-way (NoSuchMethodError). The app serves LIBRARY, so it never builds a request, reads a
# response, reads a status's user message or calls the gRPC client; the test does all of these.
# These rules keep exactly those members, and nothing the lane proves: the Service, the server-side
# stubs and the messages' own fields still stand on the rules in main. Release builds never see
# this file.
#
# Regenerate after changing the test: `tools/instrumentation-keep/check.sh` builds both APKs and
# prints a rule for every method and field the test APK references that neither APK defines
# (superclasses included). Empty output means this file is complete.

-keep class androidx.concurrent.futures.CallbackToFutureAdapter$Completer {
    boolean set(java.lang.Object);
    boolean setException(java.lang.Throwable);
}
-keep class androidx.concurrent.futures.CallbackToFutureAdapter {
    com.google.common.util.concurrent.ListenableFuture getFuture(androidx.concurrent.futures.CallbackToFutureAdapter$Resolver);
}
-keep class androidx.concurrent.futures.DirectExecutor {
    androidx.concurrent.futures.DirectExecutor INSTANCE;
}
-keep class androidx.concurrent.futures.ResolvableFuture {
    boolean setException(java.lang.Throwable);
}
-keep class androidx.tracing.Trace {
    void forceEnableAppTracing();
}
