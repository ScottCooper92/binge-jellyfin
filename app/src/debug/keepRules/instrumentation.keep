    java.lang.Object handshake$default(com.binge.companion.contracts.library.v1.LibraryServiceGrpcKt$LibraryServiceCoroutineStub,com.binge.companion.contracts.library.v1.HandshakeRequest,io.grpc.Metadata,kotlin.coroutines.Continuation,int,java.lang.Object);
    void <init>(io.grpc.Channel,io.grpc.CallOptions,int,kotlin.jvm.internal.DefaultConstructorMarker);
}
